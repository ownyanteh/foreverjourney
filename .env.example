# ─────────────────────────────────────────────────────────────────────────────
# Our Forever Journey — Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB connection string (Atlas M0 free tier works fine for this app)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Session Encryption ────────────────────────────────────────────────────────
# A random 32+ character secret used by iron-session to encrypt cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars

# ── Application URL ───────────────────────────────────────────────────────────
# Your production domain (no trailing slash). Used for generating invitation links.
APP_URL=https://your-app.vercel.app
# Also expose for client-side use:
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── OpenRouteService (routing) ────────────────────────────────────────────────
# Free API key (no credit card): https://openrouteservice.org/dev/#/signup
# Server-side only — keep SECRET. Used for Directions API calls.
# Map tiles come from OpenFreeMap and need no key.
ORS_API_KEY=your-openrouteservice-api-key

# ── Cloudinary (media uploads) ────────────────────────────────────────────────
# Create a free account at cloudinary.com. Find these in your dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email Notifications (optional) ───────────────────────────────────────────
# Used to notify the admin when the recipient responds. Remove if not needed.
# Sign up at resend.com for a free API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The admin email address to notify
ADMIN_NOTIFICATION_EMAIL=you@example.com

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
